# ========================
# MONTA — Environment Variables
# ========================

# General
APP_ENV=development
APP_NAME=monta
SECRET_KEY=change-me-in-production
DEBUG=true

# Backend — FastAPI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4

# Database — PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=monta
POSTGRES_USER=monta_user
POSTGRES_PASSWORD=monta_pass
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# Qdrant — Vector Memory
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=monta_memory

# Storage
UPLOAD_DIR=./storage/uploads
RENDER_DIR=./storage/renders
MAX_UPLOAD_SIZE_MB=500

# Vision Models
QWEN_VL_MODEL_PATH=./model_weights/qwen-vl
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Speech — Whisper
WHISPER_MODEL_SIZE=large-v3

# Local Models
QWEN3_MODEL_PATH=./model_weights/qwen3
LLAMA3_MODEL_PATH=./model_weights/llama3

# Video Processing
FFMPEG_THREADS=4
MAX_CLIP_DURATION_SECONDS=240
SUPPORTED_FORMATS=mp4,mov
MAX_CLIPS_1080P=20
MAX_CLIPS_4K=4

# Audio Studio
AUDIO_SAMPLE_RATE=44100
AUDIO_FORMAT=wav

# Render
RENDER_RESOLUTIONS=720p,1080p,4k
DEFAULT_RENDER_FORMAT=mp4

# LangGraph
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langchain-api-key
LANGCHAIN_PROJECT=monta
