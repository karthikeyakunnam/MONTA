# ========================
# MONTA — Environment Variables
# ========================

# General
APP_ENV=development
APP_NAME=monta
SECRET_KEY=change-me-in-production
DEBUG=true

# Backend — FastAPI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4

# Database — PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=monta
POSTGRES_USER=monta_user
POSTGRES_PASSWORD=monta_pass
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# Qdrant — Vector Memory
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=monta_memory

# Storage (Layer 2 — media gateway)
# uploads land in ${STORAGE_ROOT}/uploads/{project_id}/{clip_id}.{ext}
STORAGE_ROOT=./storage
RENDER_DIR=./storage/renders
# per-file ceiling, enforced while streaming
MAX_UPLOAD_SIZE_MB=500
# whole multipart request ceiling
MAX_REQUEST_SIZE_MB=4096
# ffprobe is killed by process group after this
PROBE_TIMEOUT_SECONDS=30
# concurrent ffprobe processes; 0 = derive from CPU count
PROBE_MAX_CONCURRENCY=0

# Vision Models
QWEN_VL_MODEL_PATH=./model_weights/qwen-vl
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Layers 3-7 — model providers (ordered fallback chains; empty = disabled)
# Keys: gemini | qwen | qwen_vl | openai_compatible
MONTA_TEXT_PROVIDERS=
MONTA_VISION_PROVIDERS=
# failover | consensus (query all providers, arbitrate per field)
MONTA_ARBITRATION=failover
# LLM Story Judge; must differ from the refiner model
MONTA_JUDGE_PROVIDERS=
# weight of the LLM judge vs the heuristic judge
MONTA_LLM_JUDGE_WEIGHT=0.5
MONTA_PROVIDER_MAX_CONCURRENCY=16
MONTA_PROVIDER_MAX_ATTEMPTS=3
# Qwen via DashScope compatible-mode, or a self-hosted vLLM/SGLang endpoint
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_TEXT_MODEL=qwen-plus
QWEN_VL_MODEL=qwen-vl-max
# Any other OpenAI-compatible /chat/completions endpoint
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_VISION=false

# Layers 3-7 — runtime
MONTA_MEMORY_DSN=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
MONTA_MEMORY_POOL_SIZE=10
MONTA_STORY_REFINER=false
MONTA_MAX_PARALLEL_CLIPS=8
MONTA_MEDIA_TIMEOUT_S=120
MONTA_INTEL_CACHE_SIZE=10000
# media inputs must live under these directories
MONTA_MEDIA_ROOTS=./storage/uploads
# JSON written by shared.calibration (Calibrator.save)
MONTA_CALIBRATION_PATH=
# share of users held out of narrative memory (experiment)
MONTA_MEMORY_CONTROL_SHARE=0.1
MONTA_MEMORY_EXPERIMENT_SALT=narrative-memory-v1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Speech — Whisper
WHISPER_MODEL_SIZE=large-v3

# Local Models
QWEN3_MODEL_PATH=./model_weights/qwen3
LLAMA3_MODEL_PATH=./model_weights/llama3

# Video Processing — ingest limits (Layer 2)
FFMPEG_THREADS=4
MAX_CLIP_DURATION_SECONDS=240
SUPPORTED_FORMATS=mp4,mov,mkv
MAX_CLIPS_1080P=20
MAX_MINUTES_1080P=10
MAX_CLIPS_4K=4
MAX_MINUTES_4K=4

# Job queue hand-off (Layer 2 -> workers). The API submits by task name only and never
# imports worker code, so the broker being down degrades to a 503 instead of a crash.
QUEUE_ENABLED=true
PIPELINE_TASK_NAME=tasks.run_pipeline
QUEUE_SUBMIT_TIMEOUT_SECONDS=5

# Progress fan-out (Redis pub/sub + a capped history list so a reconnect replays)
PROGRESS_CHANNEL_PREFIX=monta:progress
PROGRESS_HISTORY_KEY_PREFIX=monta:progress:history
PROGRESS_HISTORY_LENGTH=50

# Single-user local mode: requests without an X-MONTA-User header act as this user.
DEFAULT_USER_ID=local
DEFAULT_USER_EMAIL=local@monta.test

# Frontend (Layer 1). Must be reachable from the *browser*, and must be the API host
# itself: Next.js rewrites do not upgrade WebSocket connections.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NEXT_PUBLIC_MONTA_USER=local
BACKEND_ORIGIN=http://localhost:8000

# Audio Studio
AUDIO_SAMPLE_RATE=44100
AUDIO_FORMAT=wav

# Render
RENDER_RESOLUTIONS=720p,1080p,4k
DEFAULT_RENDER_FORMAT=mp4

# LangGraph
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langchain-api-key
LANGCHAIN_PROJECT=monta
